{"nodes":[{"id":"user_ui","type":"text","text":"**AI购票用户**\n\n输入购票诉求\n(城市/艺人/票档/张数/手机号/购票人)","x":-260,"y":260,"width":270,"height":160,"color":"2"},{"id":"program_chat_api","type":"text","text":"**ProgramController**\n`/program/chat`\n\n接收 `prompt/chatId/userId`","x":80,"y":260,"width":300,"height":150,"color":"2"},{"id":"orchestrator","type":"text","text":"**AiConversationOrchestratorService**\n\n统一编排入口\n路由 + 状态回写","x":440,"y":260,"width":330,"height":160,"color":"1"},{"id":"intent_router","type":"text","text":"**IntentRouterService**\n\n识别 `orderIntent`\n(规则 + 小模型)","x":840,"y":120,"width":290,"height":150,"color":"4"},{"id":"general_chat","type":"text","text":"**普通问答链路**\n\n非购票意图走通用流式回答","x":1240,"y":20,"width":280,"height":130,"color":"3"},{"id":"order_state_db","type":"text","text":"**ai_order_execution_state**\n\n会话级状态持久化\nstate/currentStep/slots/plan","x":860,"y":500,"width":320,"height":170,"color":"6"},{"id":"order_plan_execute","type":"text","text":"**OrderPlanExecuteService**\n\nPlan-Execute 状态机\nINIT -> CHECK -> LOCK -> PAY -> CONFIRM","x":1240,"y":260,"width":360,"height":190,"color":"5"},{"id":"slot_extract","type":"text","text":"**槽位抽取与合并**\n\n模型抽取 + 规则抽取\n缺失字段回问用户","x":1680,"y":260,"width":320,"height":170,"color":"5"},{"id":"waiting_input","type":"text","text":"**WAITING_USER_INPUT**\n\n返回缺失字段\n等待用户补全","x":2050,"y":120,"width":280,"height":140,"color":"5"},{"id":"check_lock","type":"text","text":"**CHECK + LOCK**\n\n节目匹配/用户校验\n票档价格匹配/余票校验","x":2060,"y":340,"width":320,"height":170,"color":"5"},{"id":"pay_gate","type":"text","text":"**PAY Gate**\n\n未确认则回显参数\n等待“确认下单”","x":2450,"y":340,"width":280,"height":150,"color":"5"},{"id":"ai_program","type":"text","text":"**AiProgram.createOrder**\n\n组装下单参数\n调用 Program/User/Ticket/Order 工具","x":2820,"y":340,"width":320,"height":170,"color":"3"},{"id":"gateway_order_api","type":"text","text":"**Gateway API**\n`/damai/program/program/order/create/v1`","x":3180,"y":340,"width":310,"height":130,"color":"2"},{"id":"program_service","type":"text","text":"**program-service**\n\n校验并创建节目订单","x":3550,"y":260,"width":260,"height":130,"color":"1"},{"id":"order_service","type":"text","text":"**order-service**\n\n落库订单/返回 orderNumber","x":3550,"y":430,"width":260,"height":130,"color":"1"},{"id":"done_response","type":"text","text":"**DONE**\n\n返回订单号 + 订单列表地址\n引导用户去支付","x":3180,"y":560,"width":310,"height":150,"color":"2"}],"edges":[{"id":"e1","fromNode":"user_ui","fromSide":"right","toNode":"program_chat_api","toSide":"left","label":"提交购票请求","color":"5"},{"id":"e2","fromNode":"program_chat_api","fromSide":"right","toNode":"orchestrator","toSide":"left","label":"进入编排","color":"5"},{"id":"e3","fromNode":"orchestrator","fromSide":"top","toNode":"intent_router","toSide":"bottom","label":"意图路由","color":"4"},{"id":"e4","fromNode":"intent_router","fromSide":"right","toNode":"general_chat","toSide":"left","label":"orderIntent=false","color":"3"},{"id":"e5","fromNode":"intent_router","fromSide":"bottom","toNode":"order_plan_execute","toSide":"top","label":"orderIntent=true","color":"5"},{"id":"e6","fromNode":"order_plan_execute","fromSide":"left","toNode":"order_state_db","toSide":"right","label":"读写执行状态","color":"6"},{"id":"e7","fromNode":"order_plan_execute","fromSide":"right","toNode":"slot_extract","toSide":"left","label":"抽取并合并槽位","color":"5"},{"id":"e8","fromNode":"slot_extract","fromSide":"top","toNode":"waiting_input","toSide":"bottom","label":"槽位缺失","color":"5"},{"id":"e9","fromNode":"waiting_input","fromSide":"left","toNode":"user_ui","toSide":"right","label":"补充信息","color":"5"},{"id":"e10","fromNode":"slot_extract","fromSide":"bottom","toNode":"check_lock","toSide":"top","label":"槽位完整","color":"5"},{"id":"e11","fromNode":"check_lock","fromSide":"right","toNode":"pay_gate","toSide":"left","label":"校验通过","color":"5"},{"id":"e12","fromNode":"pay_gate","fromSide":"top","toNode":"waiting_input","toSide":"right","label":"未确认下单","color":"5"},{"id":"e13","fromNode":"pay_gate","fromSide":"right","toNode":"ai_program","toSide":"left","label":"确认下单","color":"3"},{"id":"e14","fromNode":"ai_program","fromSide":"right","toNode":"gateway_order_api","toSide":"left","label":"HTTP创建订单","color":"2"},{"id":"e15","fromNode":"gateway_order_api","fromSide":"right","toNode":"program_service","toSide":"left","label":"路由转发","color":"1"},{"id":"e16","fromNode":"program_service","fromSide":"bottom","toNode":"order_service","toSide":"top","label":"RPC/Feign下单","color":"1"},{"id":"e17","fromNode":"order_service","fromSide":"left","toNode":"done_response","toSide":"right","label":"返回orderNumber","color":"2"},{"id":"e18","fromNode":"done_response","fromSide":"left","toNode":"user_ui","toSide":"right","label":"展示结果并引导支付","color":"2"},{"id":"e19","fromNode":"order_plan_execute","fromSide":"bottom","toNode":"done_response","toSide":"left","label":"状态DONE回传","color":"1"}]}
