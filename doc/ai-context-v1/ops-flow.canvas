		{"id":"ops_alert","type":"text","text":"**Alert/Trace Tool**\n告警与链路信号\n补充观测证据","x":3100,"y":950,"width":300,"height":160,"color":"4"},
		{"id":"ops_metric","type":"text","text":"**Metric Query Tool**\nPrometheus\nCPU/内存/GC/线程","x":3360,"y":430,"width":300,"height":160,"color":"4"},
		{"id":"ops_log","type":"text","text":"**Log Query Tool**\nElasticsearch\n关键词/链路/错误统计","x":2800,"y":-30,"width":300,"height":160,"color":"4"},
		{"id":"ops_state","type":"text","text":"**ConversationStateService**\n\n写回窗口\n维护会话状态","x":1640,"y":1280,"width":320,"height":160,"color":"1"},
