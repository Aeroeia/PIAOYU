{
	"nodes":[
		{"id":"ops_controller","type":"text","text":"**ProgramController**\n`/program/chat/mcp`\n\n接收 `prompt/chatId/userId`","x":160,"y":345,"width":300,"height":140,"color":"2"},
		{"id":"ops_orchestrator","type":"text","text":"**AiConversationOrchestratorService**\n\n统一编排与流式输出","x":400,"y":-80,"width":330,"height":150,"color":"1"},
		{"id":"ops_user","type":"text","text":"**User / SRE**\n\n输入运维问题\n(告警、超时、CPU飙高等)","x":-300,"y":20,"width":250,"height":130,"color":"2"},
		{"id":"ops_intent","type":"text","text":"**IntentRouterService**\n`FACT / CONTINUE / COMMAND`\n\n小模型 + 规则降级","x":1000,"y":-165,"width":300,"height":160,"color":"4"},
		{"id":"ops_stream","type":"text","text":"**Streaming Diagnosis**\n\n输出根因、证据与建议动作","x":1730,"y":90,"width":320,"height":150,"color":"2"},
