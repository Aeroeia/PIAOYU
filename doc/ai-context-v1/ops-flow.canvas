		{"id":"ops_context","type":"text","text":"**PromptOrchestrationService**\n\n摘要 + recent10 + 历史片段\n构建诊断上下文","x":520,"y":775,"width":330,"height":170,"color":"5"},
		{"id":"ops_mcp","type":"text","text":"**MCP ToolCallbackProvider**\n\n统一工具调用网关","x":2440,"y":280,"width":320,"height":150,"color":"4"},
